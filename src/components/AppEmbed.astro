---
import CodeSource from './CodeSource.astro';
import AppEmbedRuntime from './AppEmbedRuntime.vue';

interface Props {
	app: string;
	componentProps?: Record<string, unknown>;
	client?: 'load' | 'visible';
	showSource?: boolean;
	sourceName?: string;
	sourceOnly?: boolean;
}

const {
	app,
	componentProps = {},
	client = 'visible',
	showSource = false,
	sourceName,
	sourceOnly = false,
} = Astro.props;

const sources = import.meta.glob<string>('../examples/**/*.vue', {
	query: '?raw',
	import: 'default',
});
const componentPath = `../examples/${app.replace(/\.vue$/, '')}.vue`;
const loadSource = sources[componentPath];

if ((showSource || sourceOnly) && !loadSource) {
	throw new Error(`AppEmbed "${app}" could not load its Vue source`);
}
const source = (showSource || sourceOnly) ? await loadSource() : undefined;
---

{!sourceOnly && client === 'load' && (
	<AppEmbedRuntime app={app} componentProps={componentProps} client:load />
)}
{!sourceOnly && client === 'visible' && (
	<AppEmbedRuntime app={app} componentProps={componentProps} client:visible />
)}
{typeof source === 'string' && (
	<CodeSource name={sourceName ?? `${app}.vue`} source={source} />
)}
