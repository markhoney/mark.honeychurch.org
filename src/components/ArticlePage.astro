---
import {render} from 'astro:content';
import BlogPostList from './BlogPostList.astro';
import BlogOverview from './BlogOverview.astro';
import CodeFile from './CodeFile.astro';
import AppEmbed from './AppEmbed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaList from './MediaList.astro';
import TaxonomyIndex from './TaxonomyIndex.astro';
import type {ContentEntry} from '../lib/content';
import {articleDescription, pagePath} from '../lib/content';

interface Props {
	entry: ContentEntry;
}

const {entry} = Astro.props;
const {Content} = await render(entry);
const path = pagePath(entry);
const isPost = Boolean(entry.data.date);
const title = entry.data.title ?? 'Mark Honeychurch';
---

<BaseLayout
	title={title}
	description={articleDescription(entry)}
	type={isPost ? 'article' : 'website'}
	publishedTime={entry.data.date}
>
	<main class:list={['page', 'page-card', {'is-post': isPost}]}>
		{isPost && <div class="post-banner" aria-hidden="true"></div>}
		<article class="content">
			<header class="page-heading">
				{entry.data.title && <h1>{entry.data.title}</h1>}
				{
					entry.data.date && (
						<time datetime={entry.data.date.toISOString()}>
							{entry.data.date.toLocaleDateString('en-NZ', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</time>
					)
				}
				{
					(entry.data.categories.length > 0 || entry.data.tags.length > 0) && (
						<p class="taxonomy">
							{[...entry.data.categories, ...entry.data.tags].join(' · ')}
						</p>
					)
				}
			</header>
			<div class="markdown-content">
				<Content components={{AppEmbed, BlogOverview, BlogPostList, CodeFile, TaxonomyIndex}} />
			</div>
			<slot />
			{path === '/media/' && <MediaList />}
		</article>
	</main>
</BaseLayout>
