---
import {blogEntriesByTaxonomy, taxonomySlug} from '../lib/content';
import PostList from './PostList.astro';

interface Props {
	category: string;
}

const {category} = Astro.props;
const categorySlug = taxonomySlug(category);
const entries = (await blogEntriesByTaxonomy('category', category)).filter(
	entry => taxonomySlug(entry.data.categories[0] ?? '') === categorySlug,
);
---

<PostList entries={entries} />
