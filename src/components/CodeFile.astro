---
import CodeSource from './CodeSource.astro';
import type {CodeLanguage} from 'astro';

interface Props {
	file: string;
	lang?: CodeLanguage;
	label?: string;
	name?: string;
	open?: boolean;
}

const {
	file,
	lang = inferLanguage(file),
	label = 'Source',
	name = file.replace(/^demos\//, ''),
	open = true,
} = Astro.props;
const demoSources = import.meta.glob('./demos/**/*.{cjs,cpp,cs,js,json,md,mdx,php,py,vue}', {
	eager: true,
	query: '?raw',
	import: 'default',
});
const legacySources = import.meta.glob('../assets/code/**/*.{cjs,cpp,cs,js,json,md,mdx,php,py,vue}', {
	eager: true,
	query: '?raw',
	import: 'default',
});
const key = file.startsWith('demos/')
	? `./${file}`
	: `../assets/code/${file}`;
const source = demoSources[key] ?? legacySources[key];

if (typeof source !== 'string') {
	throw new Error(`CodeFile "${file}" was not found`);
}

function inferLanguage(path: string) {
	const extension = path.split('.').at(-1)?.toLowerCase();
	const language = ({
		cjs: 'javascript',
		cs: 'csharp',
		cpp: 'cpp',
		js: 'javascript',
		json: 'json',
		md: 'markdown',
		mdx: 'mdx',
		php: 'php',
		py: 'python',
		vue: 'vue',
	} as const)[extension ?? ''] ?? 'text';
	return language as CodeLanguage;
}
---

<CodeSource name={name} source={source} lang={lang} label={label} open={open} />
