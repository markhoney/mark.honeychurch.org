---
import CodeSource from './CodeSource.astro';
import type {CodeLanguage} from 'astro';

interface Props {
	file: string;
	lang?: CodeLanguage;
	label?: string;
	name?: string;
	open?: boolean;
}

const {
	file,
	lang = inferLanguage(file),
	label = 'Source',
	name = file,
	open = false,
} = Astro.props;
const sources = import.meta.glob<string>('../examples/**/*.{cjs,cpp,cs,js,json,md,mdx,php,py,vue}', {
	query: '?raw',
	import: 'default',
});
const loadSource = sources[`../examples/${file}`];

if (!loadSource) {
	throw new Error(`CodeFile "${file}" was not found`);
}
const source = await loadSource();

function inferLanguage(path: string) {
	const extension = path.split('.').at(-1)?.toLowerCase();
	const language = ({
		cjs: 'javascript',
		cs: 'csharp',
		cpp: 'cpp',
		js: 'javascript',
		json: 'json',
		md: 'markdown',
		mdx: 'mdx',
		php: 'php',
		py: 'python',
		vue: 'vue',
	} as const)[extension ?? ''] ?? 'text';
	return language as CodeLanguage;
}
---

<CodeSource name={name} source={source} lang={lang} label={label} open={open} />
