---
import {Code} from 'astro:components';
import type {CodeLanguage} from 'astro';

interface Props {
	name: string;
	source: string;
	lang?: CodeLanguage;
	label?: string;
	open?: boolean;
}

const {
	name,
	source,
	lang = 'vue',
	label = 'Vue component',
	open = false,
} = Astro.props;
---

<details class="component-source" open={open}>
	<summary>{label}: <code>{name}</code></summary>
	<Code code={source} lang={lang} theme="nord" wrap />
</details>
