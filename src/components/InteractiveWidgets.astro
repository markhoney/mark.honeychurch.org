---
import events from '../data/music-events.json';
import stations from '../data/stations.json';
import timeMappings from '../data/times.json';
import astrology from '../data/astrology.json';

interface Props {
	path: string;
}

const {path} = Astro.props;
const is = (value: string) => path === value;
type TimeRow = {
	time: string;
	vertical?: string;
	horizontal?: string;
	rotated?: string;
	reversed?: string;
};

function transposedTimes(clock: 12 | 24) {
	const output: Record<string, Record<string, string>> = {};
	const save = (time: string, type: string, transformed: string) => {
		output[time] ??= {};
		output[time][type] = transformed;
	};

	for (const [hour, newHour] of Object.entries(timeMappings.vertical.hours)) {
		for (const [minute, newMinute] of Object.entries(timeMappings.vertical.minutes)) {
			save(`${hour}:${minute}`, 'vertical', `${newHour}:${newMinute}`);
		}
	}
	for (const type of ['horizontal', 'rotated', 'reversed'] as const) {
		for (const [hour, newMinute] of Object.entries(timeMappings[type].hours)) {
			for (const [minute, newHour] of Object.entries(timeMappings[type].minutes)) {
				save(`${hour}:${minute}`, type, `${newHour}:${newMinute}`);
			}
		}
	}

	const valid = (value: string) => {
		const [hour, minute] = value.split(':').map(Number);
		return hour >= 1 && hour <= 12 && minute >= 0 && minute <= 59;
	};

	return Object.entries(output)
		.map(([time, values]) => ({time, ...values}))
		.filter(row =>
			clock === 24 ||
			(valid(row.time) &&
				Object.values(row).filter(value => value && value !== row.time).some(valid)),
		) as TimeRow[];
}
