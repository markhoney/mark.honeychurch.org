<script>
	import QRCode from 'qrcode';

	const input = <T extends HTMLElement>(id: string) =>
		document.getElementById(id) as T | null;
	const number = (element: {value: string}) => Number(element.value);
	const rotate = (message: string, rotation: number) =>
		[...message].map(letter => {
			const code = letter.charCodeAt(0);
			if (code >= 65 && code <= 90) return String.fromCharCode(((code - 65 + rotation) % 26) + 65);
			if (code >= 97 && code <= 122) return String.fromCharCode(((code - 97 + rotation) % 26) + 97);
			return letter;
		}).join('');
	const randomUint = () => crypto.getRandomValues(new Uint32Array(1))[0];

	const decimal = input<HTMLInputElement>('decimal-input');
	const octal = input<HTMLOutputElement>('octal-output');
	const binary = input<HTMLOutputElement>('binary-output');
	const updateNumber = () => {
		if (!decimal || !octal || !binary) return;
		const value = Number.parseInt(decimal.value, 10);
		octal.value = Number.isNaN(value) ? '' : value.toString(8);
		binary.value = Number.isNaN(value) ? '' : value.toString(2);
	};
	decimal?.addEventListener('input', updateNumber);
	updateNumber();

	const divider = input<HTMLInputElement>('divider-gain');
	const dividerOutput = input<HTMLDListElement>('divider-output');
	const updateDivider = () => {
		if (!divider || !dividerOutput) return;
		const target = number(divider);
		const values = [1, 1.2, 1.5, 1.8, 2.2, 2.7, 3.3, 3.9, 4.7, 5.6, 6.8, 8.2, 10, 12, 15, 18, 22, 27, 33, 39, 47, 56, 68, 82, 100, 1e9];
		if (!(target > 0 && target < 1)) {
			dividerOutput.textContent = 'Gain must be greater than zero and less than one.';
			return;
		}
		let best = {difference: Infinity, gain: 0, r1: 0, r2: 0, r3: 0, r4: 0};
		for (let r1 = 0; r1 < values.length - 1; r1++) {
			for (let r2 = r1; r2 < values.length; r2++) {
				const p1 = values[r1] * values[r2] / (values[r1] + values[r2]);
				for (let r3 = 0; r3 < values.length - 1; r3++) {
					for (let r4 = r3; r4 < values.length; r4++) {
						const p2 = values[r3] * values[r4] / (values[r3] + values[r4]);
						const gain = p2 / (p1 + p2);
						const difference = Math.abs(target - gain);
						if (difference < best.difference) {
							best = {difference, gain, r1: values[r1], r2: values[r2], r3: values[r3], r4: values[r4]};
						}
					}
				}
			}
		}
		dividerOutput.innerHTML = `<dt>Actual gain</dt><dd>${best.gain.toFixed(6)}</dd><dt>R1 / R2</dt><dd>${best.r1} / ${best.r2} kohm</dd><dt>R3 / R4</dt><dd>${best.r3} / ${best.r4} kohm</dd>`;
	};
	divider?.addEventListener('input', updateDivider);
	updateDivider();

	const plain = input<HTMLTextAreaElement>('caesar-plain');
	const rotation = input<HTMLSelectElement>('caesar-rotation');
	const cipherOutput = input<HTMLTextAreaElement>('caesar-output');
	const updateCaesar = () => {
		if (plain && rotation && cipherOutput) {
			cipherOutput.value = rotate(plain.value, number(rotation));
		}
	};
	plain?.addEventListener('input', updateCaesar);
	rotation?.addEventListener('change', updateCaesar);
	updateCaesar();

	input<HTMLButtonElement>('caesar-guess')?.addEventListener('click', () => {
		const cipher = input<HTMLTextAreaElement>('caesar-cipher')?.value ?? '';
		const output = input<HTMLOutputElement>('caesar-guess-output');
		const expected = {e: 0.127, t: 0.091, a: 0.082, o: 0.075, i: 0.07, n: 0.067, s: 0.063, h: 0.061, r: 0.06};
		let best = {score: Infinity, rotation: 0, text: ''};
		for (let shift = 1; shift < 26; shift++) {
			const text = rotate(cipher, shift);
			let score = 0;
			for (const [letter, frequency] of Object.entries(expected)) {
				const actual = [...text.toLowerCase()].filter(char => char === letter).length / Math.max(text.length, 1);
				score += Math.abs(actual - frequency);
			}
			if (score < best.score) best = {score, rotation: shift, text};
		}
		if (output) output.textContent = `Rotation ${best.rotation}: ${best.text}`;
	});

	let audioContext: AudioContext | null = null;
	let oscillator: OscillatorNode | null = null;
	let gainNode: GainNode | null = null;
	const toneToggle = input<HTMLButtonElement>('tone-toggle');
	toneToggle?.addEventListener('click', () => {
		if (oscillator) {
			oscillator.stop();
			oscillator = null;
			toneToggle.textContent = 'Play';
			return;
		}
		audioContext = new AudioContext();
		oscillator = audioContext.createOscillator();
		gainNode = audioContext.createGain();
		oscillator.connect(gainNode).connect(audioContext.destination);
		oscillator.type = input<HTMLSelectElement>('tone-shape')?.value as OscillatorType ?? 'sine';
		oscillator.frequency.value = number(input<HTMLInputElement>('tone-frequency')!);
		gainNode.gain.value = number(input<HTMLInputElement>('tone-volume')!) / 100;
		oscillator.start();
		toneToggle.textContent = 'Stop';
	});
	input<HTMLInputElement>('tone-frequency')?.addEventListener('input', event => {
		if (oscillator) oscillator.frequency.value = number(event.currentTarget as HTMLInputElement);
	});
	input<HTMLInputElement>('tone-volume')?.addEventListener('input', event => {
		if (gainNode && audioContext) gainNode.gain.setTargetAtTime(number(event.currentTarget as HTMLInputElement) / 100, audioContext.currentTime, 0.02);
	});
	input<HTMLSelectElement>('tone-shape')?.addEventListener('change', event => {
		if (oscillator) oscillator.type = (event.currentTarget as HTMLSelectElement).value as OscillatorType;
	});

	input<HTMLButtonElement>('coin-flip')?.addEventListener('click', () => {
		const output = input<HTMLOutputElement>('coin-result');
		if (output) output.textContent = randomUint() % 2 ? 'Heads' : 'Tails';
	});
	input<HTMLButtonElement>('die-roll')?.addEventListener('click', () => {
		const output = input<HTMLOutputElement>('die-result');
		if (output) output.textContent = String((randomUint() % 20) + 1);
	});

	const qrText = input<HTMLInputElement>('qr-text');
	const qrSize = input<HTMLInputElement>('qr-size');
	const qrError = input<HTMLSelectElement>('qr-error');
	const qrColor = input<HTMLInputElement>('qr-color');
	const qrCanvas = input<HTMLCanvasElement>('qr-canvas');
	const updateQr = async () => {
		if (!qrText || !qrSize || !qrCanvas) return;
		await QRCode.toCanvas(qrCanvas, qrText.value, {
			width: number(qrSize),
			margin: 2,
			errorCorrectionLevel: qrError?.value as 'L' | 'M' | 'Q' | 'H' ?? 'M',
			color: {dark: qrColor?.value ?? '#222222', light: '#ffffff'},
		});
	};
	qrText?.addEventListener('input', updateQr);
	qrSize?.addEventListener('input', updateQr);
	qrError?.addEventListener('change', updateQr);
	qrColor?.addEventListener('input', updateQr);
	updateQr();

	let scannerStream: MediaStream | null = null;
	let scannerFrame = 0;
	const scannerVideo = input<HTMLVideoElement>('scanner-video');
	const scannerOutput = input<HTMLOutputElement>('scanner-output');
	const stopScanner = () => {
		cancelAnimationFrame(scannerFrame);
		scannerStream?.getTracks().forEach(track => track.stop());
		scannerStream = null;
	};
	input<HTMLButtonElement>('scanner-start')?.addEventListener('click', async () => {
		type BarcodeResult = {rawValue: string};
		type Detector = {detect: (source: CanvasImageSource) => Promise<BarcodeResult[]>};
		const BarcodeDetector = (window as unknown as {
			BarcodeDetector?: new(options: {formats: string[]}) => Detector;
		}).BarcodeDetector;
		if (!BarcodeDetector || !scannerVideo || !scannerOutput) {
			if (scannerOutput) scannerOutput.textContent = 'QR scanning is not supported by this browser.';
			return;
		}
		scannerStream = await navigator.mediaDevices.getUserMedia({video: {facingMode: 'environment'}});
		scannerVideo.srcObject = scannerStream;
		const detector = new BarcodeDetector({formats: ['qr_code']});
		const scan = async () => {
			const result = await detector.detect(scannerVideo);
			if (result[0]) {
				scannerOutput.textContent = result[0].rawValue;
				stopScanner();
				return;
			}
			scannerFrame = requestAnimationFrame(scan);
		};
		scan();
	});
	input<HTMLButtonElement>('scanner-stop')?.addEventListener('click', stopScanner);

	let recorder: MediaRecorder | null = null;
	let recordStream: MediaStream | null = null;
	const recordButton = input<HTMLButtonElement>('evp-record');
	recordButton?.addEventListener('click', async () => {
		const playback = input<HTMLAudioElement>('evp-playback');
		if (recorder?.state === 'recording') {
			recorder.stop();
			recordButton.textContent = 'Start recording';
			return;
		}
		recordStream = await navigator.mediaDevices.getUserMedia({audio: true});
		const chunks: Blob[] = [];
		recorder = new MediaRecorder(recordStream);
		recorder.addEventListener('dataavailable', event => chunks.push(event.data));
		recorder.addEventListener('stop', () => {
			recordStream?.getTracks().forEach(track => track.stop());
			if (playback) {
				playback.src = URL.createObjectURL(new Blob(chunks));
				playback.hidden = false;
			}
		});
		recorder.start();
		recordButton.textContent = 'Stop recording';
	});

	const spiritButton = input<HTMLButtonElement>('spiritbox-toggle');
	let spiritAudio: HTMLAudioElement | null = null;
	let spiritTimer = 0;
	spiritButton?.addEventListener('click', () => {
		if (spiritTimer) {
			clearInterval(spiritTimer);
			spiritTimer = 0;
			spiritAudio?.pause();
			spiritButton.textContent = 'Start spirit box';
			return;
		}
		const stationList = JSON.parse(spiritButton.dataset.stations ?? '[]') as Array<{name: string; url: string}>;
		const retune = () => {
			const station = stationList[randomUint() % stationList.length];
			spiritAudio?.pause();
			spiritAudio = new Audio(station.url);
			spiritAudio.play().catch(() => {});
			const label = input<HTMLParagraphElement>('spiritbox-station');
			if (label) label.textContent = station.name;
		};
		retune();
		spiritTimer = window.setInterval(retune, 2500);
		spiritButton.textContent = 'Stop spirit box';
	});

	input<HTMLButtonElement>('webcam-start')?.addEventListener('click', async () => {
		const video = input<HTMLVideoElement>('webcam-video');
		const stream = await navigator.mediaDevices.getUserMedia({video: true});
		if (video) video.srcObject = stream;
	});

	const wikiEdits = input<HTMLUListElement>('wikipedia-edits');
	if (wikiEdits) {
		fetch('https://en.wikipedia.org/w/api.php?action=query&list=usercontribs&ucuser=Markhoney&uclimit=30&ucprop=title%7Ctimestamp&format=json&origin=*')
			.then(response => response.json())
			.then(data => {
				const edits = (data.query?.usercontribs ?? []) as Array<{title: string; timestamp: string}>;
				wikiEdits.replaceChildren(...edits.map(edit => {
					const item = document.createElement('li');
					const link = document.createElement('a');
					link.href = `https://en.wikipedia.org/wiki/${encodeURIComponent(edit.title.replaceAll(' ', '_'))}`;
					link.textContent = edit.title;
					const time = document.createElement('time');
					time.textContent = ` ${new Date(edit.timestamp).toLocaleDateString('en-NZ')}`;
					item.append(link, time);
					return item;
				}));
			})
			.catch(() => {
				wikiEdits.innerHTML = '<li>Recent edits could not be loaded.</li>';
			});
	}
</script>
