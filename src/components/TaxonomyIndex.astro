---
import {blogTaxonomyValues, taxonomySlug} from '../lib/content';

interface Props {
	type: 'category' | 'tag';
}

const {type} = Astro.props;
const values = await blogTaxonomyValues(type);
---

<section>
	<h2>{type === 'category' ? 'Categories' : 'Tags'}</h2>
	<ul class="taxonomy-index">
		{
			values.map(value => (
				<li>
					<a href={`/blog/${type}/${taxonomySlug(value)}/`}>{value}</a>
				</li>
			))
		}
	</ul>
</section>
