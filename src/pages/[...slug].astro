---
import type {GetStaticPaths} from 'astro';
import ArticlePage from '../components/ArticlePage.astro';
import type {PageEntry} from '../lib/content';
import {pageEntries, pagePath} from '../lib/content';

export const getStaticPaths = (async () => {
	const interactivePages = new Set([
		'/test/webcam/',
		'/status/facebook/',
		'/status/twitter/',
		'/status/steam/',
		'/status/wikipedia/',
	]);
	const entries = (await pageEntries()).filter(
		entry => pagePath(entry) !== '/' && !interactivePages.has(pagePath(entry)),
	);
	return entries.map(entry => ({
		params: {slug: pagePath(entry).replace(/^\/|\/$/g, '')},
		props: {entry},
	}));
}) satisfies GetStaticPaths;

interface Props {
	entry: PageEntry;
}

const {entry} = Astro.props;
---

<ArticlePage entry={entry} />
