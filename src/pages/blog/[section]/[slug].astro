---
import type {GetStaticPaths} from 'astro';
import ArticlePage from '../../../components/ArticlePage.astro';
import {publishedBlogEntries, taxonomySlug} from '../../../lib/content';
import type {BlogEntry} from '../../../lib/content';

export const getStaticPaths = (async () => {
	const entries = await publishedBlogEntries();
	return entries.map(entry => ({
			params: {
				section: taxonomySlug(entry.data.categories[0] ?? 'random'),
				slug: String(entry.data.slug ?? entry.id),
			},
			props: {entry},
		}));
}) satisfies GetStaticPaths;

interface Props {
	entry: BlogEntry;
}

const {entry} = Astro.props;
---

<ArticlePage entry={entry} />
