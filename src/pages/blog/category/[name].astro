---
import {getCollection} from 'astro:content';
import type {GetStaticPaths} from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import {sortNewest, taxonomySlug} from '../../../lib/content';

export const getStaticPaths = (async () => {
	const entries = await getCollection('blog');
	const publishedEntries = entries.filter(entry => !entry.data.draft);
	const categories = [...new Set(publishedEntries.flatMap(entry => entry.data.categories))];

	return categories.map(name => ({
		params: {name: taxonomySlug(name)},
		props: {
			name,
			entries: sortNewest(
				publishedEntries.filter(entry =>
					entry.data.title && entry.data.categories.includes(name)),
			),
		},
	}));
}) satisfies GetStaticPaths;

const {name, entries} = Astro.props;
---

<BaseLayout title={`Category: ${name}`}>
	<main class="page page-card">
		<article class="content">
			<header class="page-heading">
				<h1><a href="/blog/category/">Category</a>: {name}</h1>
			</header>
			<PostList entries={entries} />
		</article>
	</main>
</BaseLayout>
