---
import ArticlePage from '../../../components/ArticlePage.astro';
import CodeSource from '../../../components/CodeSource.astro';
import EvpRecorder from '../../../components/demos/code/evp/recorder.vue';
import recorderSource from '../../../components/demos/code/evp/recorder.vue?raw';
import SpiritBox from '../../../components/demos/code/evp/spiritbox.vue';
import spiritBoxSource from '../../../components/demos/code/evp/spiritbox.vue?raw';
import {requiredBlog} from '../../../lib/page';
const entry = await requiredBlog('evp');
---
<ArticlePage entry={entry}>
	<EvpRecorder client:load />
	<CodeSource name="code/evp/recorder.vue" source={recorderSource} />
	<SpiritBox client:load />
	<CodeSource name="code/evp/spiritbox.vue" source={spiritBoxSource} />
</ArticlePage>
