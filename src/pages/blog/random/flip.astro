---
import ArticlePage from '../../../components/ArticlePage.astro';
import CodeSource from '../../../components/CodeSource.astro';
import CoinFlip from '../../../../components/code/coin/flip.vue';
import coinSource from '../../../../components/code/coin/flip.vue?raw';
import D20Roll from '../../../../components/code/coin/d20.vue';
import dieSource from '../../../../components/code/coin/d20.vue?raw';
import {requiredEntry} from '../../../lib/page';
const entry = await requiredEntry('blog/random/flip/index');
---
<ArticlePage entry={entry}>
	<CoinFlip client:load />
	<CodeSource name="code/coin/flip.vue" source={coinSource} />
	<D20Roll client:load />
	<CodeSource name="code/coin/d20.vue" source={dieSource} />
</ArticlePage>
