---
import ArticlePage from '../../../components/ArticlePage.astro';
import CodeSource from '../../../components/CodeSource.astro';
import CoinFlip from '../../../components/demos/code/coin/flip.vue';
import coinSource from '../../../components/demos/code/coin/flip.vue?raw';
import D20Roll from '../../../components/demos/code/coin/d20.vue';
import dieSource from '../../../components/demos/code/coin/d20.vue?raw';
import {requiredBlog} from '../../../lib/page';
const entry = await requiredBlog('flip');
---
<ArticlePage entry={entry}>
	<CoinFlip client:load />
	<CodeSource name="code/coin/flip.vue" source={coinSource} />
	<D20Roll client:load />
	<CodeSource name="code/coin/d20.vue" source={dieSource} />
</ArticlePage>
