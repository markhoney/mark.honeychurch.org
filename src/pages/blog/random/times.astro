---
import ArticlePage from '../../../components/ArticlePage.astro';
import CodeSource from '../../../components/CodeSource.astro';
import TimesTable from '../../../components/demos/code/times/table.vue';
import source from '../../../components/demos/code/times/table.vue?raw';
import {requiredBlog} from '../../../lib/page';
const entry = await requiredBlog('times');
---
<ArticlePage entry={entry}>
	<TimesTable client:load clock={24} />
	<TimesTable client:load clock={12} />
	<CodeSource name="code/times/table.vue" source={source} />
</ArticlePage>
