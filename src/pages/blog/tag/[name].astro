---
import type {GetStaticPaths} from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import {
	blogEntriesByTaxonomy,
	blogTaxonomyValues,
	taxonomySlug,
} from '../../../lib/content';

export const getStaticPaths = (async () => {
	const tags = await blogTaxonomyValues('tag');

	return Promise.all(tags.map(async name => ({
		params: {name: taxonomySlug(name)},
		props: {name, entries: await blogEntriesByTaxonomy('tag', name)},
	})));
}) satisfies GetStaticPaths;

const {name, entries} = Astro.props;
---

<BaseLayout title={`Tag: ${name}`}>
	<main class="page page-card">
		<article class="content">
			<header class="page-heading">
				<h1><a href="/blog/tag/">Tag</a>: {name}</h1>
			</header>
			<PostList entries={entries} />
		</article>
	</main>
</BaseLayout>
