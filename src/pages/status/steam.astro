---
import ArticlePage from '../../components/ArticlePage.astro';
import CodeSource from '../../components/CodeSource.astro';
import SteamProfile from '../../examples/embed/steam.vue';
import source from '../../examples/embed/steam.vue?raw';
import {requiredPage} from '../../lib/content';
const entry = await requiredPage('status/steam/index');
---
