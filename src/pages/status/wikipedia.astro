---
import ArticlePage from '../../components/ArticlePage.astro';
import CodeSource from '../../components/CodeSource.astro';
import WikipediaEdits from '../../../components/embed/wikipedia.vue';
import source from '../../../components/embed/wikipedia.vue?raw';
import {requiredEntry} from '../../lib/page';
const entry = await requiredEntry('status/wikipedia/index');
---
<ArticlePage entry={entry}>
	<WikipediaEdits client:load />
	<CodeSource name="embed/wikipedia.vue" source={source} />
</ArticlePage>
