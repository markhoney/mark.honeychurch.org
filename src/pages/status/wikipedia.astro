---
import ArticlePage from '../../components/ArticlePage.astro';
import CodeSource from '../../components/CodeSource.astro';
import WikipediaEdits from '../../examples/embed/wikipedia.vue';
import source from '../../examples/embed/wikipedia.vue?raw';
import {requiredPage} from '../../lib/content';
const entry = await requiredPage('status/wikipedia/index');
---
<ArticlePage entry={entry}>
	<WikipediaEdits client:load />
	<CodeSource name="embed/wikipedia.vue" source={source} />
</ArticlePage>
